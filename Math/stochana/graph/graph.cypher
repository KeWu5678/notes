// --- statements ------------------------------------------------------
CREATE (n:Statement:Definition {id: 's/1.1.1', ref: '1.1.1', _kind: 'Definition', _page: 5, proved_here: false, statement_text: 'Let X = (Xt )t∈I and Y = (Yt )t∈I be stochastic processes defined on the same probability space. • X and Y are called indistinguishable if P[Xt = Yt for all t ∈ I] = 1. • X and Y are called modifications if P[Xt = Yt ] = 1 for all t ∈ I.'});
CREATE (n:Statement:Definition {id: 's/1.1.2', ref: '1.1.2', _kind: 'Definition', _page: 6, proved_here: false, statement_text: 'The stochastic processes X and Y have the same finite dimensional distributions if P[Xti ∈ Bi for all i = 1, .., n] = P[Yti ∈ Bi for all i = 1, .., n] for all 0 ≤ t1 ≤ ... ≤ tn , all n ∈ N and all Bi ∈ B (i = 1, ..., n).'});
CREATE (n:Statement {id: 's/1.1.3', ref: '1.1.3', _kind: 'Proposition', _page: 6, proved_here: true, statement_text: 'i) If X and Y are indistinguishable, then they are modifications. ii) If X and Y are modifications, then they have the same finite dimensional distributions.'});
CREATE (n:Statement {id: 'ex/1', ref: '1', _kind: 'Exercise', _page: 6, proved_here: false, statement_text: 'Prove that the converse implications do not hold in general.'});
CREATE (n:Statement {id: 's/1.1.4', ref: '1.1.4', _kind: 'Proposition', _page: 6, proved_here: true, statement_text: 'If X and Y are modifications and all trajectories are left-continuous (or all trajectories are right-continuous), then X and Y are indistinguishable.'});
CREATE (n:Statement:Definition {id: 's/1.1.5', ref: '1.1.5', _kind: 'Definition', _page: 7, proved_here: false, statement_text: 'A stochastic process X defined on a probability space (Ω, F, P) is called measurable, if the mapping (t, ω) ↦ Xt (ω) from (I × Ω, B ⊗ F) to (R, B) is measurable.'});
CREATE (n:Statement:Definition {id: 's/1.1.6', ref: '1.1.6', _kind: 'Definition', _page: 7, proved_here: false, statement_text: 'A family of σ-fields Fs ⊂ Ft ⊂ F (s ≤ t) on (Ω, F) is called a filtration. We set F∞ ∶= σ(⋃t≥0 Ft ). A probability space (Ω, F, (Ft ), P) equipped with a filtration is called a filtered probability space or stochastic basis.'});
CREATE (n:Statement:Definition {id: 's/1.1.7', ref: '1.1.7', _kind: 'Definition', _page: 7, proved_here: false, statement_text: '• A stochastic process X defined on a filtered probability space (Ω, F, (Ft ), P) is called – progressively measurable with respect to (Ft ) if for all t ∈ I the mapping (ω, s) ↦ Xs (ω) from (Ω × [0, t], Ft ⊗ Bt ) to (R, B) is measurable; – adapted to the filtration (Ft ) if the mapping ω ↦ Xt (ω) from (Ω, Ft ) to (R, B) is measurable for all t ∈ I. • The progressive σ-field on Ω × [0, ∞) generated by a filtration (Ft ) is the smallest σ-field such that all progressive processes (considered as mappings on Ω × [0, ∞)) are measurable. • The predictable σ-field on Ω × [0, ∞) generated by a filtration (Ft ) is the smallest σ-field such that all left-continuous adapted processes (considered as mappings on Ω×[0, ∞)) are measurable.'});
CREATE (n:Statement {id: 'ex/2', ref: '2', _kind: 'Exercise', _page: 7, proved_here: false, statement_text: '(*) i) Show that the progressive σ-field is the σ-field on Ω × [0, ∞) is given by the set {A ⊆ Ω × [0, ∞) ∶ A ∩ (Ω × [0, t]) ∈ Ft ⊗ Bt } . In other words, show that a process is progressively measurable if and only if it is measurable w.r.t. the progressive σ-field. (ii) Show that the σ-fields generated by the following sets of functions coincide: a) the set of adapted left-continuous functions b) the set of all elementary functions, that is functions of the form n Xt (ω) = e−1 (ω) + ∑ ej (ω)1(tj ,tj+1 ] (t) j=0 where 0 = t0 < t1 < .... < tn and ej is Ftj -measurable and e−1 is F0 -measurable and bounded. c) the space of predictable processes of the form: for A ∈ Fs with s > 0, respectively, A ∈ F0 Xr (ω) = 1A×(s,t] (ω, r), Xr (ω) = 1A×0 (ω, r) d) the space of continuous functions.'});
CREATE (n:Statement {id: 'ex/3', ref: '3', _kind: 'Exercise', _page: 8, proved_here: false, statement_text: 'let X = (Xt )t≥0 be a real-valued progressively measurable process such that for every t ≥ 0, t ∫ ∣Xs (ω)∣ ds < ∞ for all ω ∈ Ω 0 or X ≥ 0. Prove that the process t Yt (ω) ∶= ∫ Xs (ω)ds 0 is progressively measurable. Hint: Use Tonelli’s (Fubini’s) theorem.'});
CREATE (n:Statement {id: 's/1.1.8', ref: '1.1.8', _kind: 'Lemma', _page: 8, proved_here: true, statement_text: 'Let X be a progressively measurable stochastic process. Then X is measurable and adapted.'});
CREATE (n:Statement {id: 'ex/4', ref: '4', _kind: 'Exercise', _page: 8, proved_here: false, statement_text: 'Show that a measurable process does not have to be progressively measurable and that an adapted process does not need to be measurable.'});
CREATE (n:Statement {id: 's/1.1.9', ref: '1.1.9', _kind: 'Proposition', _page: 9, proved_here: false, statement_text: 'If X is adapted and measurable, then it has a progressively measurable modification.'});
CREATE (n:Statement {id: 's/1.1.10', ref: '1.1.10', _kind: 'Proposition', _page: 9, proved_here: true, statement_text: 'If X is adapted and all trajectories are right-continuous (or all trajectories are left-continuous), then X is progressively measurable.'});
CREATE (n:Statement:Definition {id: 's/1.1.11', ref: '1.1.11', _kind: 'Definition', _page: 9, proved_here: false, statement_text: 'A stochastic process X is called continuous, if all trajectories are continuous. It is called càdlàg - which stands for “continue à droite, limites à gauche” - (respectively, càglàd) if all trajectories are right (left)-continuous with left (right) limits.'});
CREATE (n:Statement {id: 'ex/5', ref: '5', _kind: 'Exercise', _page: 9, proved_here: false, statement_text: '(*) Prove that a càdlàg function f ∶ [0, ∞) → R has at most countably many jumps.'});
CREATE (n:Statement:Definition {id: 's/1.1.12', ref: '1.1.12', _kind: 'Definition', _page: 9, proved_here: false, statement_text: 'A stochastic process B on a probability space (Ω, F, P) is called (standard) Brownian motion (BM) if B0 = 0 and B has • independent increments: for all 0 ≤ s1 ≤ s2 ≤ ... ≤ sn ≤ s < t < ∞, Bt − Bs ⊥⊥ (Bs1 , ..., Bsn ) • stationary increments: for all 0 ≤ s < t < ∞, Bt − Bs ∼ N (0, t − s) • almost surely continuous sample paths'});
CREATE (n:Statement:Definition {id: 's/1.1.13', ref: '1.1.13', _kind: 'Definition', _page: 9, proved_here: false, statement_text: 'A stochastic process N on a probability space (Ω, F, P) is called Poisson process with parameter λ > 0 if • N0 = 0 • N is a càdlàg process • N has independent increments: for all 0 ≤ s1 ≤ s2 ≤ ... ≤ sn ≤ s < t < ∞, Nt − Ns ⊥⊥ (Ns1 , ..., Nsn ) • N has Poisson distributed increments: for all 0 ≤ s < t < ∞, (λ(t − s))k −λ(t−s) P(Nt − Ns = k) = e k! More generally, a stochastically continuous process X is called a Lévy process if X0 = 0 and if X is a càdlàg process with stationary independent increments.'});
CREATE (n:Statement:Definition {id: 's/1.2.1', ref: '1.2.1', _kind: 'Definition', _page: 10, proved_here: false, statement_text: 'We say that a filtration (Gt ) satisfies the usual conditions if it is complete and right-continuous.'});
CREATE (n:Statement:Definition {id: 's/1.2.2', ref: '1.2.2', _kind: 'Definition', _page: 10, proved_here: false, statement_text: 'For a stochastic process X we denote by F̃tX ∶= σ(Xs , 0 ≤ s ≤ t) the filtration generated by X and put X F̃∞ ∶= σ(Xt ∶ t ∈ I). The completion of (F̃tX ) is defined by FtX ∶= F̃tX ∨ N for all t ∈ [0, ∞]. 1 For two sets A and B the symmetric difference A∆B is defined by A∆B = (A/B) ∪ (B/A).'});
CREATE (n:Statement {id: 'ex/6', ref: '6', _kind: 'Exercise', _page: 11, proved_here: false, statement_text: 'Give an example that shows that (F̃tX ) is not right-continuous in general (we will see that the completion of the Brownian filtration is right-continuous). In what follows we put I¯ = [0, ∞] if I = [0, ∞) and [0,T] else.'});
CREATE (n:Statement:Definition {id: 's/1.2.3', ref: '1.2.3', _kind: 'Definition', _page: 11, proved_here: false, statement_text: 'Let (Ft ) be a filtration on (Ω, F, P). • The mapping τ ∶ Ω → I¯ is called a stopping time if {τ ≤ t} ∈ Ft for all t ∈ I. We define Fτ ∶= {A ∈ F ∶ A ∩ {τ ≤ t} ∈ Ft for all t ∈ I} • The mapping τ ∶ Ω → I¯ is called an optional time if {τ < t} ∈ Ft for all t ∈ I. We define Fτ + ∶= {A ∈ F ∶ A ∩ {τ < t} ∈ Ft for all t ∈ I}'});
CREATE (n:Statement {id: 'ex/7', ref: '7', _kind: 'Exercise', _page: 11, proved_here: false, statement_text: 'i) Show that every stopping is an optional time and that the two concepts coincide if the filtration is right-continuous. ii) Show that for any stopping time τ the set Fτ is a σ-field. iii) Show that for any stopping time τ the set {τ ≤ s} belongs to Fτ for all s ∈ I; in particular, τ is Fτ -measurable.'});
CREATE (n:Statement {id: 's/1.2.4', ref: '1.2.4', _kind: 'Lemma', _page: 11, proved_here: true, statement_text: 'Let I = [0, ∞) and let X ∶ Ω → R be right-(or left-)continuous and adapted. Let Γ ⊂ R be non-empty, and consider the first entrance time τΓ ∶= inf{t ≥ 0 ∶ Xt ∈ Γ} (inf ∅ ∶= ∞). • If Γ is open, then τΓ is an optional time. • If X is continuous and Γ is closed, then τ is a stopping time.'});
CREATE (n:Statement {id: 'ex/8', ref: '8', _kind: 'Exercise', _page: 12, proved_here: false, statement_text: 'Let X ∶ Ω → R be right-(or left-)continuous and adapted. Prove that the first entrance time to an open set is a stopping time if the filtration satisfies the usual conditions. Give an example that shows that the first entrance time to an open set is not necessarily a stopping time if the filtration does not satisfy the usual conditions.'});
CREATE (n:Statement {id: 's/1.2.5', ref: '1.2.5', _kind: 'Lemma', _page: 12, proved_here: false, statement_text: 'i) If τ is an optional time and θ ∈ R+ , then τ + θ is optional. ii) The sum, minimum and maximum of stopping times is a stopping time. iii) The sum of optional times is an optional time. iv) The infimum, supremum, limit inferior and limit superior of a sequence of optional times is an optional time. v) The supremum of a sequence of stopping times is a stopping time. vi) If T and S are stopping times and A ∈ FS , then A ∩ {S ≤ T } ∈ FT . In particular, if S ≤ T , then FS ⊂ FT . vii) If T and S are stopping times, then FT ∧S = FT ∩ FS and each of the events {T < S}, {S < T }, {T ≤ S}, {S ≤ T } and {T = S} belongs to FT ∩ FS .'});
CREATE (n:Statement {id: 's/1.2.6', ref: '1.2.6', _kind: 'Proposition', _page: 12, proved_here: true, statement_text: 'Let X be a progressively measurable stochastic process and τ be a stopping time. Then the random variable Xτ (ω) ∶= Xτ (ω) (ω) defined on {τ < ∞} (and only there!) is Fτ -measurable. Moreover, the stopped process X τ = (Xτ ∧t ) is progressively measurable.'});
CREATE (n:Statement:Definition {id: 's/1.3.1', ref: '1.3.1', _kind: 'Definition', _page: 13, proved_here: false, statement_text: 'A stochastic process M = (Mt ) is called a martingale (with respect to (Ft )) if • M is (Ft )-adapted • Mt ∈ L1 (P) for every t ∈ I • E[Mt ∣Fs ] = Ms for all 0 ≤ s ≤ t. The process is called a sub- respectively, super martingale if the equality in the third item is replaced by ≥, respectively, ≤.'});
CREATE (n:Statement {id: 's/1.3.2', ref: '1.3.2', _kind: 'Theorem', _page: 13, proved_here: false, statement_text: '• (Doob’s maximal inequality) If (Mn , Fn )n∈N is a non-negative sub-martingale (or a martingale), then λp P(sup ∣Mm ∣ ≥ λ) ≤ E∣Mn ∣p . m≤n If Mn ∈ Lp for p > 1, then p p E[sup ∣Mm ∣p ] ≤ ( ) E∣Mn ∣p . m≤n p−1 • (Martingale convergence) Let (Mn , Fn )n∈N be an Lp bounded (super)martingale, i.e. sup E∣Mn ∣p < ∞. n Then there exists a random variable M∞ such that E∣M∞ ∣p < ∞ and Mt → M∞ a.s. If p > 1 we also have convergence in Lp (this is not true for p = 1). • (Optional sampling) Let (Mn ) be a uniformly integrable discrete time (Fn )-martingale, and let σ, τ be two stopping times. Then E(Mτ ∣Fσ ) = Mτ ∧σ a.s. Analogous results hold for sub- and supermartingales. We now show that the preceding results carry over to continuous time martingales under continuity conditions on the same paths.'});
CREATE (n:Statement {id: 's/1.3.3', ref: '1.3.3', name: 'Doob’s maximal inequality', _kind: 'Theorem', _page: 14, proved_here: true, statement_text: '(Doob’s maximal inequality) Let M be a right-continuous martingale (or a nonnegative sub-martingale) and put Mt∗ ∶= sup ∣Ms ∣. 0≤s≤t Then, Mt∗ is measurable amd for any λ ≥ 0 and t ≥ 0 λp P(Mt∗ ≥ λ) ≤ E∣Mt ∣p . Furthermore, if p > 1, then p p E∣Mt∗ ∣p ≤ ( ) E∣Mt ∣p . p−1 Proof: By right-continuity we can write Mt∗ = sup (∣Ms ∣ ∨ ∣Mt ∣) .'});
CREATE (n:Statement {id: 's/1.3.4', ref: '1.3.4', _kind: 'Corollary', _page: 15, proved_here: false, statement_text: 'If (Mt ) is a right-continuous (non-negative sub-) martingale. Then almost every sample path M (ω) is bounded on any bounded time interval.'});
CREATE (n:Statement {id: 's/1.3.5', ref: '1.3.5', name: 'Doob’s Optional Sampling Theorem', _kind: 'Theorem', _page: 15, proved_here: true, statement_text: '(Doob’s Optional Sampling Theorem) Let (Mt ) be a uniformly integrable rightcontinuous martingale (e.g. M is Lp -bounded for p > 1). Let τ, σ be finite stopping times. Then E[Mτ ∣Fσ ] = Mτ ∧σ and E[Mτ ∣Fσ+ ] = Mτ ∧σ a.s. In particular, the stopped process M τ = (Mt∧τ ) is a martingale. Similar results hold for sub-martingales.'});
CREATE (n:Statement {id: 's/1.3.6', ref: '1.3.6', _kind: 'Remark', _page: 16, proved_here: false, statement_text: 'We emphasize that the last step of the above proof used the fact that the discrete martingale (Mn ) is closed by a random variable M∞ so that Mτn = M∞ on {τn = ∞}. We did not assume/use that the continuous-time martingale is closed for which we have no proof yet; see also'});
CREATE (n:Statement {id: 'ex/9', ref: '9', _kind: 'Exercise', _page: 16, proved_here: false, statement_text: '(*) Suppose that (Xt ) is a right-continuous sub-martingale and that σ, τ are two bounded stopping times with σ ≤ τ a.s. Then Xτ and Xσ are integrable and E[Xτ ∣Fσ ] ≥ Xσ .'});
CREATE (n:Statement {id: 's/1.3.7', ref: '1.3.7', _kind: 'Corollary', _page: 16, proved_here: true, statement_text: 'A right continuous (Ft )-martingale M is also an (Ft+ )-martingale.'});
CREATE (n:Statement {id: 's/1.3.8', ref: '1.3.8', name: 'Martingale convergence', _kind: 'Theorem', _page: 17, proved_here: true, statement_text: '(Martingale convergence) Let M be a right-continuous Lp bounded (sub)martingale where p > 1. Then there exists a random variable M∞ such that E∣M∞ ∣p < ∞ and Mt → M∞ a.s. and in Lp . If p = 1, then almost sure convergence (but not convergence in L1 ) holds if M is continuous.'});
CREATE (n:Statement {id: 's/1.3.9', ref: '1.3.9', name: 'Discrete time up-crossing lemma', _kind: 'Lemma', _page: 18, proved_here: false, statement_text: '(Discrete time up-crossing lemma) Let (Mt , Ft )t≥0 be a super-martingale and let F = {0 ≤ t1 < t2 < ... < tn } ⊂ [0, ∞) be a finite set of time points. Let UF (α, β, M ) be the number of up-crossings of the interval [α, β] by the restricted path (Mti )ni=1 . Then E(Mtn − α)− E(Mt−n ) + α+ E [UF (α, β, M )] ≤ ≤ . β−α β−α For the case of a sub-martingale E(Mtn − α)+ E(Mt+n ) + ∣α∣ E [UF (α, β, M )] ≤ ≤ . β−α β−α For continuous time super-martingales we put for any I ⊂ [0, ∞)'});
CREATE (n:Statement {id: 's/1.3.10', ref: '1.3.10', name: 'Continuous time up-crossing lemma', _kind: 'Proposition', _page: 18, proved_here: true, statement_text: '(Continuous time up-crossing lemma) Let (Mt , Ft )t≥0 be a super-martingale and let I ⊂ [0, T ]. Then E(Mt − α)− E [UI∩Q (α, β, M )] ≤ sup . t∈[0,T ]∩Q β−α If M is right-continuous, then E(Mt − α)− E [UI (α, β, M )] ≤ sup . t≤T β−α If M is a right-continuous submartingale, then E(Mt − α)+ E(Mt+ ) + ∣α∣ E [UI (α, β, M )] ≤ sup ≤ sup . t≤T β−α t≤T β−α Proof: Let {Fn } be an increasing sequence of finite sets whose union is I ∩ Q. Then each finite set'});
CREATE (n:Statement {id: 'ex/10', ref: '10', _kind: 'Exercise', _page: 19, proved_here: false, statement_text: '(*) a) Prove the up-crossing lemma for a right-continuous super-martingale. b) Conclude that almost every sample path M (ω) of a right-continuous super-martingale admits left-limits everywhere on (0, ∞).'});
CREATE (n:Statement {id: 's/1.3.11', ref: '1.3.11', name: 'Submartingale convergence', _kind: 'Proposition', _page: 19, proved_here: false, statement_text: '(Submartingale convergence) Let (Mt , Ft )t≥0 be a right-continuous submartingale that satisfies supt≥0 E(Mt+ ) < ∞. Then there exists an integrable random variable M∞ such that Mn → M∞ P-a.s.'});
CREATE (n:Statement {id: 'ex/11', ref: '11', _kind: 'Exercise', _page: 19, proved_here: false, statement_text: '(*) Prove the above proposition. Hint. Use upcrossing on the time interval [0, n], then monotone convergence and show that supt≥0 E(Mt+ ) < ∞ is equivalent to the seemingly stronger condition supt E∣Mt ∣ < ∞. The following two exercises are very useful; the results should be known from Stochastic II. The first'});
CREATE (n:Statement {id: 'ex/12', ref: '12', _kind: 'Exercise', _page: 19, proved_here: false, statement_text: '(*) Prove that the following three conditions are equivalent for a non-negative rightcontinuous sub-martingale (Mt ). a) (Mt ) is a uniformly integrable family of random variables b) (Mt ) converges in L1 as t → ∞ c) (Mt ) converges a.s. to some M∞ ∈ L1 and (Mt )0≤t≤∞ is a sub-martingale'});
CREATE (n:Statement {id: 'ex/13', ref: '13', _kind: 'Exercise', _page: 19, proved_here: false, statement_text: '(*) Prove that the following four conditions are equivalent for a right-continuous martingale (Mt ). a) (Mt ) is a uniformly integrable family of random variables 2 If X is a sub-martingale, then X + is a sub-martingale. Hence this follows from the fact that X − = (−X)+ . b) (Mt ) converges in L1 as t → ∞ c) (Mt ) converges a.s. to some M∞ ∈ L1 and (Mt )0≤t≤∞ is a martingale d) there exists Y ∈ L1 such that Mt = E[Y ∣Ft ] a.s., for every t ≥ 0. Moreover, if d) holds, and M∞ is the random variable from c), then E[Y ∣F∞ ] = M∞ .'});
CREATE (n:Statement {id: 's/1.3.12', ref: '1.3.12', _kind: 'Theorem', _page: 20, proved_here: false, statement_text: 'Let M be an (Ft )-super-martingale and assume that (Ft ) satisfies the usual conditions. Then M has a right continuous modification if and only if the function t ↦ EMt is right continuous. If the right continuous modification exists it is also a super-martingale and can be chosen to have left limits everywhere.'});
CREATE (n:Statement {id: 's/1.3.13', ref: '1.3.13', _kind: 'Proposition', _page: 20, proved_here: true, statement_text: 'Let M be a super-martingale. Then there exists a set Ω∗ ∈ F∞ of measure one such that for all ω ∈ Ω∗ the following limits exist and are finite for all t ∈ [0, ∞): lim Ms (ω), lim Ms (ω). s↓t,s∈Q s↑t,s∈Q'});
CREATE (n:Statement {id: 's/1.3.14', ref: '1.3.14', _kind: 'Lemma', _page: 21, proved_here: false, statement_text: 'Let M be a super-martingale. • The process (Mt+ ) is integrable and E[Mt+ ∣Ft ] ≤ Mt a.s. If the mapping t ↦ EMt is rightcontinuous, then this inequality is an equality. • The process (Mt+ ) is an (Ft+ )-super-martingale and a martingale, if M is a martingale. Review: Backward martingales'});
CREATE (n:Statement {id: 's/1.3.15', ref: '1.3.15', name: 'Backwards martingale convergence', _kind: 'Lemma', _page: 21, proved_here: false, statement_text: '(Backwards martingale convergence) Let (nk ) be a sequence of decreasing numbers and (Gnk ) be a decreasing sequence of σ-fields and G∞ ∶= ⋂ Gnk . Let (Xnk ) be a (Gnk )-backwards super-martingale, that is Xnk+1 ≥ E[Xnk ∣Gnk+1 ]. Then the following holds: • The process (Xnk ) converges almost surely to a limit X∞ . • The process (Xnk ) is uniformly integrable if and only if it is L1 bounded. In this case Xnk → X∞ a.s. and in L1 and X∞ ≥ E[Xn0 ∣G∞ ]. • If X is a backwards martingale, then uniform integrability is automatically satisfied and X∞ = E[Xn0 ∣G∞ ]. The uniform integarbility of a backwards super-martingale (Xnk ) is equivalent to its L1 -boundedness. Since E[∣Xnk ∣] = E[Xnk ] + 2E[Xn−k ] ≤ E[Xn0 ] + 2E[Xn−k ]'});
CREATE (n:Statement {id: 's/1.3.16', ref: '1.3.16', _kind: 'Lemma', _page: 21, proved_here: true, statement_text: 'Let (Mt )t≥0 be a super-martingale with respect to a filtration (Ft ). Then for every 0 ≤ t ≤ s, E[Ms− ] ≤ E[Mt− ]. Proof: Fix t ≤ s. For K > 0, we define the truncated variable'});
CREATE (n:Statement {id: 's/1.3.17', ref: '1.3.17', _kind: 'Corollary', _page: 22, proved_here: true, statement_text: 'Let M be a super-martingale and (qn ) be a decreasing sequence of real numbers that converge to t from above. Then the backwards super-martingale (Mqn ) is uniformly integrable.'});
CREATE (n:Statement {id: 'ex/14', ref: '14', _kind: 'Exercise', _page: 22, proved_here: false, statement_text: 'Let X, Y be integrable random variables on (Ω, F). Let G ⊂ F be another σ-field. Let Y be G-measurable. Show that E[X∣G] ≤ Y together with EX = EY implies E[X∣G] = Y a.s.'});
CREATE (n:Statement {id: 'ex/15', ref: '15', _kind: 'Exercise', _page: 23, proved_here: false, statement_text: 'Prove missing converse implication in the proof of Theorem 1.3.12. Hint. Use backwards martingale convergence along with ∣x∣ = 2(−x)1{−x>0} + x.'});
CREATE (n:Statement:Definition {id: 's/2.0.1', ref: '2.0.1', _kind: 'Definition', _page: 25, proved_here: false, statement_text: 'A stochastic process B = (Bt )t≥0 defined on some probability space (Ω, F, P) is called a (standard) Brownian motion, if i) B0 = 0 a.s. ii) for all n ∈ N and 0 ≤ t0 < t1 < ⋅ ⋅ ⋅ < tn , we have ⎛t1 0 ⎞ ⎜ t2 − t1 ⎟ ⎜ ⎟ (Bt1 − Bt0 , . . . , Btn − Btn−1 ) ∼ N (0, Σt1 ,...,tn ), Σt1 ,...,tn ∶= ⎜ ⎟ ⎜ ⋱ ⎟ ⎜ ⎟ ⎝0 tn − tn−1 ⎠'});
CREATE (n:Statement:Definition {id: 's/2.1.1', ref: '2.1.1', _kind: 'Definition', _page: 25, proved_here: false, statement_text: 'Let (Ω, F, P) be a probability space. A random variable f ∶ Ω → R is called Gaussian if 1 − 1 (x−m)2 P(f ∈ B) = √ ∫ e 2σ2 dx, B ∈ B 2πσ 2 B for some m ∈ R and σ > 0. A random vector f = (f1 , ..., fn ) ∶ Ω → Rn 25 is called Gaussian if n ⟨f, a⟩ ∶= ∑ ai fi i=1 n is Gaussian for all a = (a1 , ..., an ) ∈ R . We call m = (m1 , ..., mn ), mi ∶= Efi the mean vector and σ = (σij ), σij ∶= E [(fi − mi )(fj − mj )]'});
CREATE (n:Statement {id: 'ex/16', ref: '16', _kind: 'Exercise', _page: 26, proved_here: false, statement_text: 'Show that if f, g are Gaussian random variables with the same mean vector and covariance matrix, then they have the same distributions.'});
CREATE (n:Statement:Definition {id: 's/2.1.2', ref: '2.1.2', _kind: 'Definition', _page: 26, proved_here: false, statement_text: 'A stochastic process X is called Gaussian if its finite dimensional distributions are Gaussian. The mean process and the covariance function are given by, respectively, mt ∶= EXt , Γ(s, t) ∶= E [(Xt − mt )(Xs − ms )] .'});
CREATE (n:Statement {id: 's/2.1.3', ref: '2.1.3', _kind: 'Theorem', _page: 26, proved_here: false, statement_text: '(Daniel-Kolmogorov) Let S be a Polish space equipped with its Borel σ-field S. Let {QJ ∶ J ⊂ I, ∣J∣ < ∞} be a consistent family of finite-dimensional distributions QJ on (S J , S J ). Then, there exists a unique probability measure P on (S I , S I ) that has all the QJ as its finite dimensional distributions.'});
CREATE (n:Statement {id: 's/2.1.4', ref: '2.1.4', _kind: 'Theorem', _page: 27, proved_here: true, statement_text: '(Existence of Gaussian processes) Let Γ∶I ×I →R be positive, semi-definite and symmetric, i.e. n ∑ Γ(ti , tj )ai aj ≥ 0, Γ(s, t) = Γ(t, s) i,j=1 for all t, s, t1 , ..., tn ∈ I, a1 , ..., an ∈ R and n ∈ N. Then, there exists a probability space (Ω, F, P) and a Gaussian process X on it such that EXt = 0, EXs Xt = Γ(s, t).'});
CREATE (n:Statement {id: 'ex/17', ref: '17', _kind: 'Exercise', _page: 27, proved_here: false, statement_text: 'Prove that the family of measures defined in the previous proof is consistent.'});
CREATE (n:Statement {id: 's/2.1.5', ref: '2.1.5', _kind: 'Example', _page: 27, proved_here: false, statement_text: '(Brownian bridge) Let I = [0, 1]. We want to construct a Gaussian process X that starts and end in 0. One possibility is to choose a Brownian motion B and to define Xt ∶= Bt − tB1 , t ∈ [0, 1]; we will see an alternative construction later. Then, for all 0 ≤ t1 ≤ ... ≤ td < 1, ⎛ 1 0 0 ⋯ 0 −t1 ⎞ ⎜ 0 1 0 ⋯ 0 −t2 ⎟ ⎜ ⎟ (Xt1 , ..., Xtd ) = A(Bt1 , ..., Btd , B1 )t , A=⎜ ⎟. ⎜ ⋯ ⋯ ⋯ ⋯ ⋯ ⋯ ⎟ ⎜ ⎟ ⎝ 0 0 0 ⋯ 1 −td ⎠ Hence, X is a Gaussian process; its covariance function can easily be computed: for each 0 ≤ s ≤ t ≤ 1 E[Xs Xt ] = E[(Bs − sB1 )(Bt − tB1 )]'});
CREATE (n:Statement {id: 's/2.1.6', ref: '2.1.6', _kind: 'Example', _page: 28, proved_here: false, statement_text: '(Fractional Browian motion) There exists a unique Gauss process X with the following covariance function: 1 Γ(s, t) = (t2H + s2H − ∣t − s∣2H ) 2 where H ∈ (0, 1) is the Hurst coefficient. The process is called fractional Brownian motion with Hurst coefficient H. The case H = 1/2 corresponds to Brownian motion. It is not entirely trivial to show'});
CREATE (n:Statement {id: 's/2.1.7', ref: '2.1.7', _kind: 'Lemma', _page: 28, proved_here: true, statement_text: '• Let (E, B) be a measurable space and I be a non-empty index set. For any set B ∈ B there exists a countable set S ⊂ I such that for any pair (x, y) ∈ E I × B the following I implication holds: x(t) = y(t) for all t ∈ S implies x ∈ B. That is, any set of functions B ∈ S I is determined by the values on a countable set J ⊂ I. • Let E be a metric space that contains at least two elements and B be a σ-field on E. Then'});
CREATE (n:Statement {id: 's/2.1.8', ref: '2.1.8', _kind: 'Remark', _page: 29, proved_here: false, statement_text: 'Let E be a complete separable metric space equipped with the Borel-σ-field E = B(E). If I is a countable set, then E I = B(E)I = B(E I ). The above lemma shows that this is not true for uncountable index sets. The intuitive reason is that σ-algebras are only stable w.r.t. countable but not uncountable operations.'});
CREATE (n:Statement {id: 's/2.1.9', ref: '2.1.9', _kind: 'Theorem', _page: 29, proved_here: true, statement_text: '(Kolmogorov-Centsov) Let X be a stochastic process on (Ω, F, P) such that E [∣Xt − Xs ∣α ] ≤ C∣t − s∣1+β , 0≤s≤t≤T for some α, β, C > 0. Then there exists a continuous modification X̃ that satisfies ⎛ ∣X̃t (ω) − X̃s (ω)∣ ⎞ P sup γ ≤δ =1 ⎝0<t−s<h(ω) ∣t − s∣ ⎠ β for some δ > 0, where h is a positive random variable and γ ∈ (0, α ).'});
CREATE (n:Statement {id: 's/2.1.10', ref: '2.1.10', _kind: 'Lemma', _page: 30, proved_here: false, statement_text: '(Borell-Cantelli) Let {An }n∈N be a sequence of events defined on a probability space (Ω, F, P). (i) If ∑n P[An ] < ∞, only finitely many An occur: P[only finitely many An occur] = 1. (ii) If ∑n P[An ] = ∞ and the events A1 , A2 , . . . are independent, infinitely many An occur: P[infinitely many An occur] = 1.'});
CREATE (n:Statement {id: 's/2.1.11', ref: '2.1.11', name: 'Existence of Brownian motion', _kind: 'Corollary', _page: 31, proved_here: true, statement_text: '(Existence of Brownian motion) Let X be a continuous Gaussian process with mean zero and covariance function Γ(s, t) = s ∧ t. Then a continuous modification B exists. In particular, a standard Brownian motion exists.'});
CREATE (n:Statement {id: 's/2.1.12', ref: '2.1.12', _kind: 'Proposition', _page: 32, proved_here: false, statement_text: '0 ≤ α < 21 , almost every trajectory of a Brownian motion belongs to C α . α2'});
CREATE (n:Statement {id: 'ex/18', ref: '18', _kind: 'Exercise', _page: 32, proved_here: false, statement_text: 'Show that the processes (Bt2 − t)t≥0 and (eαBt − 2 t ) (α ∈ R) are martingales. In t≥0 particular, a Brownian motion admits an exponential moment. 2.2 The Wiener-Lévy construction'});
CREATE (n:Statement {id: 's/2.2.1', ref: '2.2.1', _kind: 'Remark', _page: 33, proved_here: false, statement_text: 'We notice that for n = 2j + k and n′ = 2j + k ′ if k ≠ k ′ , then Gn (t)Gn′ (t) = 0. This important result will be used repeatedly in what follows. Before we state and prove the main result of this section, we establish the following useful estimate'});
CREATE (n:Statement {id: 's/2.2.2', ref: '2.2.2', _kind: 'Lemma', _page: 33, proved_here: true, statement_text: 'Let {Zn } be a sequence of i.i.d. N(0,1) distributed random variables. Then there exists an a.s. finite random variable C such that almost surely, for all n ≥ 2, √ ∣Zn ∣ ≤ C log n.'});
CREATE (n:Statement {id: 's/2.2.3', ref: '2.2.3', _kind: 'Theorem', _page: 34, proved_here: true, statement_text: 'Let {Zn } be a sequence of i.i.d. N(0,1) distributed random variables. Then, ∞ Xt ∶= ∑ λn Zn Gn (t), t ∈ [0, 1] n=1 converges uniformly on [0, 1] almost surely and X is a Brownian motion.'});
CREATE (n:Statement {id: 'ex/19', ref: '19', _kind: 'Exercise', _page: 35, proved_here: false, statement_text: 'Prove that the process X is Gaussian with µ(t) = 0 and cov(Xs , Xt ) = s ∧ t. 2.3 Weak convergence and the Wiener measure'});
CREATE (n:Statement {id: 's/2.3.1', ref: '2.3.1', _kind: 'Theorem', _page: 35, proved_here: true, statement_text: 'The space (Ω, d) is a complete, separable metric space. The metric d induces the topology of uniform convergence on Ω.'});
CREATE (n:Statement {id: 'ex/20', ref: '20', _kind: 'Exercise', _page: 36, proved_here: false, statement_text: '(*) Let us consider the following σ-algebras on C = C[0, 1]: • the Borel sigma-algebra B(C); • the sigma-algebra σ(C) generated by continuous functions f ∶ C[0, 1] → R, i.e. ⎛ ⎞ σ(C) ∶= σ ⋃ {f −1 (B), B ∈ B(R)} ; ⎝f ∈C ⎠ • the sigma-algebra σ(Z) generated by the system Z of all cylinder sets Z = {x ∈ C ∶ x(tj ) ∈ Aj , j = 1, ..., n}, with n ∈ N, 0 ≤ t1 < t2 < ⋯ < tn ≤ 1 and A1 , ..., An ∈ B(R). Show that σ(C) = B(C) = σ(Z). In particular, the mapping X ∶ (Ω, F) → (S, B(S)), ω ↦ X⋅ (ω) is measurable if and only if for all ti ∈ [0, 1] the coordinate evaluation mapping ω ↦ Xti (ω) is measurable. Hint. To show that B(S) ⊂ σ(Z) show first that every closed ε-ball is in σ(Z) and then use separability of the metric space S to conclude. To show that B(S) ⊂ σ(C(S)) let A ⊂ S be closed and find a function h ∈ C(S) such that A = {h = 0}.'});
CREATE (n:Statement:Definition {id: 's/2.3.2', ref: '2.3.2', _kind: 'Definition', _page: 36, proved_here: false, statement_text: 'Let P be the probability measure on Ω = C([0, ∞), R) w.r.t. which the canonical process is a Brownian motion. Then P is called the Wiener measure. The triple (Ω, B(C), P) is called the Wiener space. This is the canonical model when working with Brownian motion.'});
CREATE (n:Statement:Definition {id: 's/2.3.3', ref: '2.3.3', _kind: 'Definition', _page: 37, proved_here: false, statement_text: 'Let (E, B(E)) be a metric space with Borel σ-field. • A family of probability measures P on (E, B(E)) is called a) relatively (sequentially) compact, if every (Pn ) ⊂ P contains a subsequence, which converges weakly to some probability measure P on (E, B(E)), i.e. if there exists a subsequence such that ∫ g(x)Pnk (dx) Ð→ ∫ g(x)P(dx) E E for all bounded and continuous g ∶ E → R. b) tight, if for every ε > 0 there exists a compact set K such that sup P(K c ) < ε. P∈P • A family of random variables X taking values in (E, B(E)) is called tight, if for every ε > 0 there exists a compact set K ⊂ E such that sup P(X ∈ K c ) < ε. X∈X'});
CREATE (n:Statement {id: 's/2.3.4', ref: '2.3.4', name: 'Prohorov', _kind: 'Theorem', _page: 37, proved_here: false, statement_text: '(Prohorov) A family of probability measures P on a Polish space (E, d) is tight, if and only if it is weakly relatively sequentially compact.'});
CREATE (n:Statement {id: 's/2.3.5', ref: '2.3.5', _kind: 'Lemma', _page: 37, proved_here: true, statement_text: 'If a family of probability measures P on a Polish space (E, B(E)) is weakly relatively sequentially compact, then it is tight.'});
CREATE (n:Statement {id: 's/2.3.6', ref: '2.3.6', name: 'Helly’s selection theorem', _kind: 'Proposition', _page: 38, proved_here: true, statement_text: '(Helly’s selection theorem) Let V be the class of all right-continuous, increasing and bounded function F ∶ R → R. Let {Fn } ⊂ V be uniformly bounded. Then there exists F ∈ V and a subsequence {Fnk } such that Fnk (x) → F (x) for all x ∈ R in which F is continuous.'});
CREATE (n:Statement {id: 's/2.3.7', ref: '2.3.7', _kind: 'Corollary', _page: 38, proved_here: true, statement_text: 'Any tight family of probability measures P on (R, B(R)) is weakly relatively sequentially compact.'});
CREATE (n:Statement {id: 's/2.3.8', ref: '2.3.8', _kind: 'Example', _page: 39, proved_here: false, statement_text: 'This example illustrates that pointwise limits of sequences of distribution functions do not need to be distribution functions. In fact, let F be a distribution function and let Fn (x) ∶= F (x + n); Gn (x) ∶= F (x − n). Then, Fn → F̃ ≡ 1 and Gn → G̃ ≡ 0 pointwise, which are obviously not distribution functions.'});
CREATE (n:Statement {id: 'ex/21', ref: '21', _kind: 'Exercise', _page: 39, proved_here: false, statement_text: '(*) • Prove that L is a metric on the space of distribution functions. • Let (Fn ) and F be distribution functions with corresponding probability measures µn and µ. Prove µn → µ weakly if and only if L(Fn , F ) → 0.'});
CREATE (n:Statement {id: 's/2.3.9', ref: '2.3.9', name: 'Tightness on Polish spaces', _kind: 'Proposition', _page: 39, proved_here: true, statement_text: '(Tightness on Polish spaces) Let (E, d) be a Polish space. Then every Borel probability measure µ on E is tight, i.e. for every ε > 0 there exists a compact set K ⊂ E such that µ(K) ≥ 1 − ε.'});
CREATE (n:Statement {id: 's/2.3.10', ref: '2.3.10', _kind: 'Proposition', _page: 40, proved_here: true, statement_text: 'Let (K, d) be a compact metric space. Then C(K) is complete and separable.'});
CREATE (n:Statement {id: 's/2.3.11', ref: '2.3.11', name: 'Bounded Lipschitz functions are convergence-determining', _kind: 'Proposition', _page: 41, proved_here: true, statement_text: '(Bounded Lipschitz functions are convergence-determining) Let (E, d) be a Polish space. Let µn , µ be probability measures on E. Then µn ⇒ µ if ∫ f dµn → ∫ f dµ for all bounded Lipschitz functions f.'});
CREATE (n:Statement {id: 's/2.3.12', ref: '2.3.12', _kind: 'Theorem', _page: 42, proved_here: true, statement_text: 'Let (E, d) be a Polish space and let P(E) be the space of probability measures on E. Let dBL (µ, ν) ∶= sup ∣∫ f dµ − ∫ f dν∣ , f ∈BL1 (E) where BL1 (E) denotes the set of all functions f ∶ E → R such that ∥f ∥∞ ≤ 1 and Lip(f ) ≤ 1. Then dBL metrizes the weak convergence of probability measures.'});
CREATE (n:Statement {id: 's/2.3.13', ref: '2.3.13', name: 'Riesz–Markov–Kakutani Representation Theorem', _kind: 'Theorem', _page: 43, proved_here: false, statement_text: '(Riesz–Markov–Kakutani Representation Theorem) Let X be a compact Hausdorff space and L ∶ C(X) → R be a positive linear functional, i.e. L(f ) ≥ 0 whenever f ≥ 0. Then there exists a unique regular Borel measure µ on X such that L(f ) = ∫ f dµ for all f ∈ C(X). X Moreover, ∥L∥ = µ(X). In particular, if L(1) = 1, then µ is a probability measure.'});
CREATE (n:Statement {id: 's/2.3.14', ref: '2.3.14', name: 'Sequential compactness on compact metric spaces', _kind: 'Proposition', _page: 43, proved_here: true, statement_text: '(Sequential compactness on compact metric spaces) Let K be a compact metric space. Then every sequence of probability measures (µn ) ⊂ P(K) admits a subsequence (µnk ) and a probability measure µ ∈ P(K) such that dBL (µnk , µ) → 0. Equivalently, P(K) is weakly sequentially compact.'});
CREATE (n:Statement {id: 's/2.3.15', ref: '2.3.15', _kind: 'Theorem', _page: 44, proved_here: true, statement_text: 'Let (E, d) be a Polish space and let (µn ) ⊂ P(E) be tight. Then there exists a subsequence (µnk ) and a probability measure µ ∈ P(E) such that dBL (µnk , µ) → 0. 1 For this, the compactness (or at least local compactness) of K is required; compactness is not needed for the'});
CREATE (n:Statement {id: 's/2.3.16', ref: '2.3.16', name: 'Vanishing of decreasing closed sets under weak limits', _kind: 'Lemma', _page: 46, proved_here: false, statement_text: '(Vanishing of decreasing closed sets under weak limits) Let C be a compact metric space and let (µn ) be a sequence of probability measures on C. Let (Fk )k∈N be a decreasing sequence of closed subsets of C such that ∞ Fk+1 ⊂ Fk and ⋂ Fk = ∅. k=1 Then'});
CREATE (n:Statement {id: 's/2.3.17', ref: '2.3.17', _kind: 'Proposition', _page: 47, proved_here: true, statement_text: 'Let X be a Polish space and let (µn )n∈N be a sequence of probability measures on X. Assume: 1. Tightness: For every ε > 0, there exists a compact set K ⊂ X such that sup µn (X ∖ K) < ε. n 2. Pointwise convergence on Cb (X): There exists a bounded, positive, linear functional T ∶ Cb (X) → R such that ∫ f dµn =∶ Tn (f ) → T (f ) for all f ∈ Cb (X). X Then there exists a unique probability measure µ on X such that T (f ) = ∫ f dµ for all f ∈ Cb (X). X'});
CREATE (n:Statement {id: 's/2.3.18', ref: '2.3.18', _kind: 'Lemma', _page: 49, proved_here: true, statement_text: 'Let (Pn )n∈N and P be probability measures on a metric Borel space (E, B(E)). Then Pn ⇒ P if and only if every subsequence of (Pn )n∈N contains a further subsequence that converges weakly to P.'});
CREATE (n:Statement {id: 's/2.3.19', ref: '2.3.19', _kind: 'Corollary', _page: 49, proved_here: false, statement_text: 'If (Pn )n∈N is a tight sequence of probability measures on a Polish space (E, B(E)) and if each convergent subsequence converges to P, then the entire sequence converges weakly to P. Proof: By Prohorov’s theorem, (Pn )n∈N is relatively sequentially compact, i.e. every subsequence'});
CREATE (n:Statement {id: 's/2.3.20', ref: '2.3.20', _kind: 'Theorem', _page: 49, proved_here: true, statement_text: 'Let (Pn )n∈N and P be probability measures on C([0, 1], R). If the finite-dimensional distributions of the Pn converge weakly to that of P and if (Pn )n∈N is tight, then Pn ⇒ P.'});
CREATE (n:Statement {id: 's/2.3.21', ref: '2.3.21', _kind: 'Example', _page: 50, proved_here: false, statement_text: 'For every n ∈ N, let us define a function zn ∶ [0, 1] Ð→ R by zn (t) ∶= nt ⋅ 1[0, n1 ] (t) + (2 − nt)1( n1 , n2 ] (t), t ∈ [0, 1]. Then ∥ zn ∥∞ = 1 for all n ∈ N and zn (t) → 0 for all t ∈ [0, 1]. Let Pn ∶= δzn , n ∈ N and P ∶= δ0 . To show that the sequence (Pn ) does not converge weakly to P we introduce the closed set B ∶= {z ∈ C([0, 1]) ∶∥ z ∥∞ = 1}. Then P(B) = 0 and by the Portemanteau theorem the weak convergence Pn ⇒ P would give us that 1 = lim sup Pn (B) ≤ P(B),'});
CREATE (n:Statement {id: 's/2.3.22', ref: '2.3.22', name: 'Arzel`', _kind: 'Theorem', _page: 51, proved_here: false, statement_text: '(Arzelà, Ascoli) Let K and S be metric spaces where K is compact and S is complete, and let D ⊆ K be dense. Then a set A ⊆ C(K, S) is relatively compact if and only if {xt ∶ x ∈ A} is relatively compact in S for any t ∈ D and lim sup w(x, h) = 0. h→0 x∈A In this case, even the set ⋃t∈K {xt ∶ x ∈ A} is relatively compact in S.'});
CREATE (n:Statement {id: 's/2.3.23', ref: '2.3.23', name: 'Tightness in', _kind: 'Theorem', _page: 51, proved_here: true, statement_text: '(Tightness in C(K, S)) Let K and S be metric spaces where K is compact and d S is separable and complete. Let {Xn } be a sequence of random elements in C(K, S). Then Xn → X if and only if the finite-dimensional distributions converge and lim sup E[w(Xn , h) ∧ 1] = 0. (2.5) h→0 n'});
CREATE (n:Statement {id: 'ex/22', ref: '22', name: 'Centsov Tightness Condition', _kind: 'Exercise', _page: 51, proved_here: false, statement_text: '(Centsov Tightness Condition) (*) • A sequence of probability measures {µn } on C([0, 1], R) is tight if and only if the following two conditions hold. (i) for all ε > 0 there exists M such that supn µn (∣x(0)∣ > M ) < ε and (ii) for all ε, η > 0 there exists δ > 0 such that supn µn (w(x, δ) ≥ η) < ε where w denotes the modulus of continuity. • Let {X n } be a sequence of continuous stochastic processes on (Ω, F, P) that satisfies the following conditions: – supm E[∣X0m ∣ν ] ∶= M < ∞. – supm E∣Xtm − Xsm ∣α ≤ CT ∣t − s∣1+β for all T > 0 and 0 ≤ s ≤ t ≤ T . Follow the technique of the Kolmogorov-Centsov Theorem to prove that the sequence of probability measures {P ○ (X m )−1 } is tight. 2.3.3 Donsker’s invariance principle Armed with the above results we can now give an alternative proof of Donsker’s invariance principle.'});
CREATE (n:Statement {id: 's/2.3.24', ref: '2.3.24', name: 'Ottaviani', _kind: 'Proposition', _page: 53, proved_here: false, statement_text: '(Ottaviani) Let {ξn } be a sequence of i.i.d. random variables with mean 0 and variance 1 and put Tn ∶= ∑ni=1 ξi . Let {Tn∗ } be the sequence of the running maxima of {∣Tn ∣}. Then √ √ P[∣Tn ∣ ≥ r n] P[Tn∗ ≥ 2r n] ≤ , r > 1, n ∈ N. 1 − r−2 In particular,'});
CREATE (n:Statement {id: 's/2.3.25', ref: '2.3.25', name: 'Donsker’s invariance principle', _kind: 'Theorem', _page: 53, proved_here: true, statement_text: '(Donsker’s invariance principle) Let B be a Brownian motion. Under the above assumption, restricted to any compact interval (and hence on [0, ∞)) Sn∗ Ð→ B. d'});
CREATE (n:Statement:Definition {id: 's/2.4.1', ref: '2.4.1', _kind: 'Definition', _page: 54, proved_here: false, statement_text: 'Let (Ω, F, (Ft ), P) be a filtered probability space. An adapted process B is called a Brownian motion w.r.t. the filtration (Ft ) if • B0 = 0 a.s. • Bt − Bs ⊥⊥ Fs for all 0 ≤ s ≤ t < ∞ • Bt − Bs ∼ N (0, t − s) • B has almost surely continuous sample paths.'});
CREATE (n:Statement {id: 'ex/23', ref: '23', _kind: 'Exercise', _page: 55, proved_here: false, statement_text: 'Let B be a Brownian motion in the sense of the original definition and let FtB ∶= σ (Bs ∶ 0 ≤ s ≤ t) be the filtration generated by B. Then B is a Brownian motion w.r.t. the filtration (FtB ).'});
CREATE (n:Statement {id: 's/2.4.2', ref: '2.4.2', _kind: 'Remark', _page: 55, proved_here: false, statement_text: 'We notice that a Brownian motion remains a BM with respect to the completed filtration: completion of σ-fields does not affect the assumptions of Definition 2.4.1.'});
CREATE (n:Statement {id: 's/2.4.3', ref: '2.4.3', _kind: 'Proposition', _page: 55, proved_here: true, statement_text: 'The filtration (Ft ) introduced in (2.6) satisfies the usual conditions. In particular, it is right-continuous.'});
CREATE (n:Statement {id: 's/2.5.1', ref: '2.5.1', _kind: 'Theorem', _page: 56, proved_here: true, statement_text: 'Let B be a standard Brownian motion. A typical sample path B(ω) is nowhere differentiable. More precisely, the set {ω ∈ Ω ∶ for each t ∈ [0, ∞) either D+ Bt (ω) = ∞ or D+ Bt (ω) = −∞} contains an event F with P(F ) = 1. Proof: It is enough to consider the time interval [0, 1]. For fixed integers j, k ≥ 1 we define the set'});
CREATE (n:Statement {id: 'ex/24', ref: '24', _kind: 'Exercise', _page: 58, proved_here: false, statement_text: 'Prove that a Brownian sample path is a.s. nowhere Hölder continuous with exponent α > 21 . Hint. Follow the proof of nowhere differentiability. 2.5.2 The law of iterated logarithm Brownian sample paths are unbounded. The law of iterated logarithm gives the exact growth rate'});
CREATE (n:Statement {id: 's/2.5.2', ref: '2.5.2', _kind: 'Lemma', _page: 58, proved_here: true, statement_text: 'Let X ∼ N (0, 1). For every x > 0, we have 1 1 1 1 −x2 /2 e−x /2 ≤ P(X ≥ x) ≤ √ 2'});
CREATE (n:Statement {id: 's/2.5.3', ref: '2.5.3', name: 'Law of iterated logarithm', _kind: 'Theorem', _page: 58, proved_here: false, statement_text: '(Law of iterated logarithm) For a Brownian motion B in R we have a.s.'});
CREATE (n:Statement {id: 's/2.5.4', ref: '2.5.4', name: 'Blumenthal’s 0-1 law', _kind: 'Proposition', _page: 61, proved_here: true, statement_text: '(Blumenthal’s 0-1 law) Let B be a Brownian motion and (Ft ) be its canonical filtration. The σ-field F0+ ∶= ⋂t>0 Ft is trivial in the sense that P(A) ∈ {0, 1} for all A ∈ F0+ .'});
CREATE (n:Statement {id: 's/2.5.5', ref: '2.5.5', _kind: 'Corollary', _page: 61, proved_here: true, statement_text: 'For any ε > 0, sup Bs > 0, inf Bs < 0. 0≤s≤ε 0≤s≤ε'});
CREATE (n:Statement:Definition {id: 's/3.1.1', ref: '3.1.1', _kind: 'Definition', _page: 64, proved_here: false, statement_text: 'A partition Π of the time interval [0, T ] is a set of points 0 = t0 < t1 < ⋯ < tn = T . The mesh is ∣Π∣ ∶= max ∣ti − ti−1 ∣. i'});
CREATE (n:Statement:Definition {id: 's/3.1.2', ref: '3.1.2', _kind: 'Definition', _page: 64, proved_here: false, statement_text: '• The (total) variation of the function X i ∶ [0, T ] → R along the partition Π = {t0 , . . . , tn } of [0, T ] is defined by n VT (X i , Π) ∶= ∑ ∣X i (tj ) − X i (tj−1 )∣ i=1 The (total) variation on [0, T ] is defined by VT (X i ) ∶= sup {VT (X i , Π) ∶ Π is a partition of [0, T ]} . If VT (X i ) < ∞, then X i is of bounded/finite variation on [0, T ]. • The co-variation process of the functions X j , X k ∶ [0, T ] → R along the partition Π = {t0 , . . . , tn } of [0, T ] is given by Vt2 (X j , X k , Π, ) ∑ (X j (ti ) − X j (ti−1 ))(X k (ti ) − X k (ti−1 )). ti−1 ,ti ∈Π,ti ≤t The quadratic variation process of X i along Π is given by Vt2 (X i , Π) = Vt2 (X i , X i , Π), t ∈ [0, T ]. • We say that X is of continuous quadratic variation on [0, T ] if the limit ⟨X j , X k ⟩t = lim Vt2 (X j , X k , Πn ) n→∞ exists for all j, k = 1, ..., n along a sequence of partitions {Πn } with ∣Πn ∣ → 0 as n → ∞ and the map t ↦ ⟨X, Y ⟩t is continuous. The quadratic variation process ⟨X i ⟩ of the function X i is defined by ⟨X i ⟩ ∶= ⟨X i , X i ⟩. Notice that we require the quadratic variation to exist only along a given sequence of partition. For the special case of Brownian sample paths we shall show that the choice of partition is irrelevant as'});
CREATE (n:Statement {id: 's/3.1.3', ref: '3.1.3', _kind: 'Remark', _page: 65, proved_here: false, statement_text: 'Strictly speaking, we should have defined our co-variation processes along a partition Π as Vt2 (X j , X k , Π) = ∑ (X j (ti ∧ t) − X j (ti−1 ∧ t))(X k (ti ∧ t) − X k (ti−1 ∧ t)). ti−1 ,ti ∈Π In other words, when computing quantities like Vt2 (X j , X k , Π) we assume that t ∈ Π. Since we only consider continuous processes, a simple 3ε-argument shows that the two definitions result in the same limit if ∣Π∣ → 0. Our slightly sloppy definition saves us a lot of notation. In the sequel we follow the convention that t ∈ Π when computing (co-)variations. Every monotone real valued function defined on a bounded interval is of bounded variation, and every'});
CREATE (n:Statement {id: 's/3.1.4', ref: '3.1.4', _kind: 'Proposition', _page: 65, proved_here: true, statement_text: 'If X ∶ [0, T ] → R is continuous and of bounded variation, then its quadratic variation process is trivial, i.e., identically equal to zero'});
CREATE (n:Statement {id: 'ex/25', ref: '25', _kind: 'Exercise', _page: 65, proved_here: false, statement_text: 'Let X, Y ∶ [0, T ] → R be continuous and of continuous quadratic variation with respect to a common sequence of partitions {Πn }. Then the following holds: (i) The quadratic variation ⟨X, Y ⟩ exists and is continuous (along {Πn }) if and only if ⟨X + Y ⟩ exists and is continuous. (ii) ⟨⋅, ⋅⟩ defines a (not necessarily positive semi-definite) bilinear form along {Πn }. (iii) The polarization identity holds along {Πn }: 1 ⟨X, Y ⟩ = (⟨X + Y ⟩ − ⟨X⟩ − ⟨Y ⟩) . 2 In particular, co-variation processes are differences of two non-decreasing processes and hence of bounded variation (cf. Exercise 26). (iv) The Cauchy-Schwarz inequality holds along {Πn }: √'});
CREATE (n:Statement {id: 's/3.1.5', ref: '3.1.5', _kind: 'Corollary', _page: 66, proved_here: true, statement_text: 'Let X be continuous with continuous variation and A be of bounded variation. Then ⟨X + A⟩ = ⟨X⟩.'});
CREATE (n:Statement {id: 'ex/26', ref: '26', _kind: 'Exercise', _page: 66, proved_here: false, statement_text: 'Prove that a real-valued function is of bounded variation if and only if it can be represented as the difference of two non-decreasing functions. In particular, (co-)variation processes are of bounded variation.'});
CREATE (n:Statement {id: 's/3.1.6', ref: '3.1.6', _kind: 'Remark', _page: 67, proved_here: false, statement_text: 'In view of the above, we can define integrals of (e.g. bounded or continuous) functions T with respect to functions of bounded variation. In particular, the integral ∫0 f (t)d⟨X⟩t is well defined for any continuous f ∶ [0, T ] → R if X has continuous quadratic variation.'});
CREATE (n:Statement {id: 's/3.1.7', ref: '3.1.7', _kind: 'Lemma', _page: 67, proved_here: false, statement_text: 'Let X1 , X2 , Y ∶ [0, T ] → R be real-valued functions. If the integrals ∫ Y dXi exists for i = 1, 2, then the integral ∫ Y d(X1 + X2 ) exist and ∫ Y d(X1 + X2 ) = ∫ Y dX1 + ∫ Y dX2 .'});
CREATE (n:Statement {id: 's/3.1.8', ref: '3.1.8', _kind: 'Theorem', _page: 67, proved_here: true, statement_text: 'Let Y ∶ [0, T ] → R be continuous and X ∶ [0, T ] → R be of bounded variation. Then the RS integral ∫ Y dX exists.'});
CREATE (n:Statement {id: 's/3.2.1', ref: '3.2.1', _kind: 'Theorem', _page: 68, proved_here: true, statement_text: 'Let {Πn } be a sequence of partitions of [0, T ] such that ∑n ∣Πn ∣ < ∞. Then lim Vt2 (B(ω), Πn ) = t, for all t ∈ [0, T ] P-a.s. n→∞'});
CREATE (n:Statement {id: 's/3.2.2', ref: '3.2.2', _kind: 'Remark', _page: 69, proved_here: false, statement_text: 'We emphasize that we used the same sequence of partition of every ω when computing the quadratic variation of Brownian sample paths. If we were allowed to choose different partitions for different sample paths, then we could obtain any quadratic variation, including the zero process. For instance, on can prove that for any continuous function f ∶ [0, 1] → R there exists a sequence of partitions {Πn }with mesh sizes going to zero, such that Vt2 (f, Πn ) → 0 for all t ∈ [0, 1]. 3.2.1 The basic Itô formula'});
CREATE (n:Statement {id: 's/3.2.3', ref: '3.2.3', _kind: 'Proposition', _page: 69, proved_here: false, statement_text: 'Let {µn } be a sequence of signed measures on [a, b]. The sequence converges weakly to a signed measure µ if and only if supn ∥µn ∥ < ∞ and every subsequence of the sequence of distribution functions {Fµn } contain a further subsequence that converges to Fµ at all points excepting points of an at most countable set.'});
CREATE (n:Statement {id: 's/3.2.4', ref: '3.2.4', _kind: 'Corollary', _page: 69, proved_here: true, statement_text: 'Let {Πn } be a sequence of partitions of [0, T ] with ∣Πn ∣ → 0 and g ∶ [0, T ] → R continuous. Then t lim ∑ g(ti )∆i X j ∆i X k = ∫ g(s)d⟨X j , X k ⟩s for all t ∈ [0, ∞). n→∞ 0 ti ∈Πn ,ti ≤t 2 For the special case of probability measures the theorem simplifies to the well known Portemonteau theorem that states that a sequence of probability measures {µn } converges weakly to a probability measure µ if and only if the'});
CREATE (n:Statement {id: 's/3.2.5', ref: '3.2.5', _kind: 'Remark', _page: 70, proved_here: false, statement_text: 'There is another way to prove Corollary 3.2.4 that does not require Proposition 3.2.3. The proof of Exercise 25(i) shows that we can decompose the measure µn as µn = µ+n − µ−n where 2 µ+n (dt) ∶= ∑ δti (dt) (∆i (X j + X k )) and µ−n (dt) ∶= ∑ δti (dt) ((∆i X j )2 + (∆i X k )2 ) ti ∈Πn ti ∈Πn are non-negative measures and hence probability measures after suitable scaling. Again by Exercise 25(i) we know that all the distribution functions converges pointwise. Convergence in t = T shows that the total masses converge. Hence, the assertion follows from the Portemonteau theorem applied to the scaled measures. This argument works because we know that not only that the distribution function of µn but also the distribution functions associated with µ±n converge. In what follows C 1,2 (Rm × Rn ) denotes the class of all continuous functions F ∶ Rm × Rn → R whose first the partial derivatives on Rm and whose first and second partial derivatives exist on Rn exist and'});
CREATE (n:Statement {id: 's/3.2.6', ref: '3.2.6', _kind: 'Theorem', _page: 70, proved_here: true, statement_text: '(Basic Itô formula) Let X ∶ [0, T ] → Rn be continuous, of continuous QV, and let A ∶ [0, T ] → Rm be continuous and of bounded variation along a sequence of partitions {Πn }. Let F ∶ Rm × Rn → R be of class C 1,2 . Then t t F (At , Xt ) = F (A0 , X0 ) + ∫ ∇a F (As , Xs )dAs + ∫ ∇x F (As , Xs )dXs 0 0 1 n t ∂ 2 (3.1) + ∑ ∫ F (As , Xs )d⟨X j , X k ⟩s 2 j,k=1 0 ∂xj ∂xk with t ∫ ∇x F (As , Xs )dXs ∶= lim ∑ ∇x F (Ati , Xti )∆i X. 0 n ti t In particular, the integral ∫0 ∇x F (As , Xs )dXs exists as a Riemann-Stieltjes-type integral.3 3 Do note that this is not(!) a Riemann-Stieltjes integral in the sense of the usual definition. We do not have have the choice of sample points of the integrand as we always take the value of the integrand at the left end points of our'});
CREATE (n:Statement {id: 's/3.2.7', ref: '3.2.7', _kind: 'Corollary', _page: 72, proved_here: false, statement_text: 'Let f ∶ [0, T ] × R → R be of class C 1,2 and X ∶ [0, T ] → R be continuous with continuous quadratic variation ⟨X⟩. Then t t 1 t f (t, Xt ) − f (0, X0 ) = ∫ ft (s, Xs )ds + ∫ fx (s, Xs )dXs + ∫ fxx (s, Xs )d⟨X⟩s . 0 0 2 0'});
CREATE (n:Statement {id: 's/3.2.8', ref: '3.2.8', _kind: 'Corollary', _page: 72, proved_here: false, statement_text: '(Product Rule) Let (X, Y ) be continuous with continuous quadratic variation. Then t t Xt Yt − X0 Y0 = ∫ Xs dYs + ∫ Ys dXs + ⟨X, Y ⟩t . 0 0'});
CREATE (n:Statement {id: 's/3.2.9', ref: '3.2.9', _kind: 'Example', _page: 72, proved_here: false, statement_text: 'Let B be a standard Brownian motion and F ∶ R → R be twice continuously differentiable. Then a.s. t 1 t F (Bt ) = F (0) + ∫ F ′ (Bs )dBs + ∫ F ′′ (Bs )ds. (3.2) 0 2 0'});
CREATE (n:Statement {id: 's/3.2.10', ref: '3.2.10', _kind: 'Example', _page: 73, proved_here: false, statement_text: '(Geometric Brownian Motion) Given a BM B, and constants µ ∈ R and σ > 0 the geometric Brownian motion is given by the process 1 St = S0 exp (σBt + (µ − σ 2 ) t) . 2 In order to write this process in differential form we apply Itô’s formula to the exponential function x ↦ ex and to the process 1 Xt = (µ − σ 2 ) t + σBt . 2 In view of Corollary 3.1.5 we have that ⟨X⟩t = σ 2 t so Itô’s formula yields t1 t St = S0 exp(Xt ) = S0 + ∫ Su dXu + ∫ Su d⟨X⟩u 0 2 0 t 1 1 t = S0 + ∫ Su [(µ − σ 2 ) du + σdBu ] + ∫ σ 2 Su du 0 2 2 0'});
CREATE (n:Statement {id: 's/3.2.11', ref: '3.2.11', _kind: 'Proposition', _page: 73, proved_here: true, statement_text: 'Let X be real-valued, continuous and of continuous quadratic variation and f ∈ C 1 . Then the mapping t ↦ f (Xt ) is of continuous quadratic variation and t (f ′ (Xs )) d⟨X⟩s . 2'});
CREATE (n:Statement {id: 's/3.2.12', ref: '3.2.12', _kind: 'Corollary', _page: 74, proved_here: true, statement_text: 'Let X be real-valued, continuous and of continuous quadratic variation and g ∈ C 1 and G′ = g. Then the process t Yt ∶= ∫ g(Xs )dXs 0 has quadratic variation t ⟨Y ⟩t = ∫ g 2 (Xs )d⟨X⟩s . 0'});
CREATE (n:Statement {id: 's/3.2.13', ref: '3.2.13', _kind: 'Example', _page: 74, proved_here: false, statement_text: 'The quadratic variation process of the geometric Brownian motion dSt = µdt + σdBt St is given by the process t t↦∫ σ 2 Su2 du. 0'});
CREATE (n:Statement:Definition {id: 's/3.2.14', ref: '3.2.14', _kind: 'Definition', _page: 75, proved_here: false, statement_text: 'For a given family X1 , ..., Xn random variables with common density function f (⋅, θ) with unknown parameter θ the likelihood function is given by the function L(θ) ∶= f (X1 , ..., Xn , θ). The maximizer θ̂ of the function L(θ) (assuming it is unique) is called the maximum likelihood estimator (MLE) of θ, given X1 , ..., Xn . The MLE is called consistent if θ̂ → θ a.s. if n → ∞.'});
CREATE (n:Statement {id: 'ex/27', ref: '27', _kind: 'Exercise', _page: 75, proved_here: false, statement_text: '(i) Let X1 , ..., Xn independent normal random variables with unknown mean µ and unknown volatility σ 2 . Show that the MLE is consistent and given by5 1 n 1 n µ̂ = ∑ Xi ; σ̂ 2 = 2 ∑(Xi − µ̂) . n i=1 n i=1 (ii) Let St0 , ..., Stn be the realizations of a geometric Brownian motion process with fixed sample frequency δ = ti − ti−1 (i = 1, ..., n) and unknown (µ, σ 2 ). Show that n 1 1 1 n 1 f (S1 , ..., Sn , µ, σ) = (∏ ) n n exp (− 2δ ∑ (ln Sti − ln Sti−1 − (µ − σ 2 )δ)2 ) . S i=1 i σ (2πδ) 2 2σ i=1 2 (iii) Show that the MLE for geometric Brownian motion is given by'});
CREATE (n:Statement {id: 'ex/28', ref: '28', _kind: 'Exercise', _page: 75, proved_here: false, statement_text: 'Prove that σ̂ 2 → σ 2 a.s. and hence that µ̂ → µ + σ T −t0 . 5 The estimator σ̂ is consistent but not unbiased, that is, it expected value does not equal σ. 3.3 Quadratic variation of continuous local martingales'});
CREATE (n:Statement:Definition {id: 's/3.3.1', ref: '3.3.1', _kind: 'Definition', _page: 76, proved_here: false, statement_text: 'A stochastic process M = (Mt ) on a filtered probability space (Ω, F, (Ft ), P) is called a local martingale if there exists a localising sequence of stopping times {τn }, that is, a sequence of stopping times {τn } such that • τn ↑ ∞ a.s. • the stopped process M τn = Mτn ∧⋅ is a martingale w.r.t. (Ft ) for every n ∈ N. The space of all continuous local martingales is denoted Mloc ; the space of continuous local martingales starting in zero is denoted M0loc . Localising sequences are not unique. For instance, if {τn } is a localising sequence, then so is {τn ∧ n}.'});
CREATE (n:Statement {id: 's/3.3.2', ref: '3.3.2', _kind: 'Remark', _page: 76, proved_here: false, statement_text: 'If M is a continuous local martingale with localizing sequences {τn }, we may set σn ∶= inf{t ≥ 0 ∶ Mt = n} ∧ n; µn ∶= τn ∧ σn . Since M is continuous σn ↑ ∞ and so µn ↑ ∞. Moreover, since M τn is a continuous martingale and σn is a bounded stopping time it follows from optional sampling that M µn = (M τn )σn is a bounded, hence uniformly integrable martingale. Thus, whenever we are working with continuous local martingales, we may w.l.o.g. assume that the martingale is uniformly integrable after stopping.'});
CREATE (n:Statement {id: 's/3.3.3', ref: '3.3.3', _kind: 'Lemma', _page: 76, proved_here: true, statement_text: 'Let M be a local martingale such that the running maximum Mt∗ ∈ L1 for all t ≥ 0. Then M is a martingale.6 In particular, every bounded local martingale is a martingale. Proof: Let {τn } be a localising sequence and s ≤ t. Then E[Mt∧τn ∣Fs ] = Ms∧τn , Since ∣Mt∧τn ∣ ≤ ∣Mt∗ ∣'});
CREATE (n:Statement:Definition {id: 's/3.3.4', ref: '3.3.4', _kind: 'Definition', _page: 77, proved_here: false, statement_text: 'Let T be the class of all finite-valued stopping times and TT be the class of all stopping times bounded by T > 0. A stochastic process X is said to be of class D, respectively of class DL if the set {Xτ ∶ τ ∈ T }, respectively, {Xτ ∶ τ ∈ TT } is uniformly integrable for all T > 0.'});
CREATE (n:Statement {id: 's/3.3.5', ref: '3.3.5', _kind: 'Proposition', _page: 77, proved_here: true, statement_text: 'A continuous local martingale M is a martingale if and only if it is of class DL.'});
CREATE (n:Statement {id: 'ex/29', ref: '29', _kind: 'Exercise', _page: 77, proved_here: false, statement_text: 'Let X be a non-negative local martingale with EX0 < ∞. Show that X is a supermartingale.'});
CREATE (n:Statement {id: 'ex/30', ref: '30', _kind: 'Exercise', _page: 77, proved_here: false, statement_text: 'Let X be a right continuous submartingale. Show that under any of the following conditions the set {Xτ ∶ τ ∈ TT } is uniformly integrable for all T ≥ 0. • Xt ≥ 0 a.s. for all t ≥ 0. • X admits the Doob-Meyer decomposition Xt = Mt + At where M is a martingale and A is an increasing adapted process.'});
CREATE (n:Statement {id: 'ex/31', ref: '31', _kind: 'Exercise', _page: 77, proved_here: false, statement_text: 'Let M, N be local martingales and let σ, τ be stopping times. Show the following results • If τ reduces M and σ ≤ τ a.s., then σ reduces M . • The sum M + N is a local martingale. • If σ and τ both reduce M , then so does the σ ∨ τ . • The processes M τ and M τ 1{τ >0} are local martingales. • Let X be a càdlàg process and let {τn } be a sequence of stopping times such that τn ↑ ∞ a.s. and such that X τn 1{τn >0} is a local martingale for each n ∈ N. Then X is a local martingale. Hint. Use the Optional Sampling Theorem. Let X be a stochastic process. We say that a property holds locally if there exists a sequence of'});
CREATE (n:Statement {id: 'ex/32', ref: '32', _kind: 'Exercise', _page: 78, proved_here: false, statement_text: '• Let X be a process that is locally a square integrable martingale. Then X is a local martingale. • Let X be an adapted, càdlàg process and let {τn } be a sequence of stopping times such that τn ↑ ∞ a.s. If X τn 1{τn >0} is a martingale for each n ∈ N, then X is a local martingale. 3.3.2 The quadratic variation process If M is a local martingale, then M 2 is a local sub-martinagle, and hence it has increasing expected'});
CREATE (n:Statement {id: 's/3.3.6', ref: '3.3.6', _kind: 'Theorem', _page: 78, proved_here: false, statement_text: 'Let M be a continuous local square integrable (EMt2 < ∞ for all t ≥ 0) martingale with respect to a filtration that satisfies the usual conditions. Let M0 = 0. Then there exists an almost surely unique continuous process ⟨M ⟩ (called the bracket process, compensator or quadratic variation process) such that • ⟨M ⟩0 = 0 and ⟨M ⟩ is non-decreasing • M 2 − ⟨M ⟩ is a continuous local martingale (a martinagle if M is) • for any sequence of partitions {Πn } of [0, t] with ∣Πn ∣ → 0, Vt2 (M (ω), Πn ) → ⟨M ⟩t uniformly on compact time intervals in probability (ucp) The proof is given below. It follows from the proof that if M is a square integrable continuous'});
CREATE (n:Statement {id: 's/3.3.7', ref: '3.3.7', _kind: 'Corollary', _page: 79, proved_here: false, statement_text: 'Let A be a process of bounded variation, and let M be a continuous local martingale starting in zero. Then Vt2 (M (ω) + A(ω), Πn ) → ⟨M ⟩t ucp. Thus, we can write ⟨M + A⟩ = ⟨M ⟩.'});
CREATE (n:Statement {id: 's/3.3.8', ref: '3.3.8', _kind: 'Corollary', _page: 79, proved_here: true, statement_text: 'Let M be a continuous square integrable local martingale and τ be a stopping time. Then the bracket of the stopped process M τ is given by ⟨M τ ⟩t = ⟨M ⟩τ ∧t .'});
CREATE (n:Statement {id: 'ex/33', ref: '33', _kind: 'Exercise', _page: 79, proved_here: false, statement_text: 'Let M be a continuous, square integrable local martingale and assume that E⟨M ⟩∞ < ∞. Then the following holds. i) M is a martingale and both M and M 2 are uniformly integrable. 2 ii) The limit M∞ exists a.s. and EM∞ = E⟨M ⟩∞ . iii) We may take the right-continuous modification of 2 Zt ∶= E[M∞ ∣Ft ] − Mt2 which is a right-continuous (by appropriate choice of the modification), non-negative supermartingale and satisfies E[Zt ] → 0 for t → ∞ Hint. You may use without proof that for any continuous local martingale M and any stopping time τ it holds that E[Mτ2 ] ≤ E⟨M ⟩τ where M∞ 2'});
CREATE (n:Statement {id: 's/3.3.9', ref: '3.3.9', _kind: 'Proposition', _page: 80, proved_here: false, statement_text: 'Let M, N be continuous, square integrable local martingales. Let {Πn } be any sequence of partitions of [0, t] with ∣Πn ∣ → 0. Then m ∑(Mtni+1 − Mtni )(Ntni+1 − Ntni ) → ⟨M, N ⟩t ucp. i=1'});
CREATE (n:Statement {id: 's/3.3.10', ref: '3.3.10', _kind: 'Remark', _page: 80, proved_here: false, statement_text: 'For 0 ≤ s < t the following defines a defines a symmetric positiv definite bilinear form as well: ⟨M, N ⟩ts ∶= ⟨M, N ⟩t − ⟨M, N ⟩s . Hence it follows from the usual Cauchy-Schwarz inequality that a.s. √ √ ∣⟨M, N ⟩t − ⟨M, N ⟩s ∣ ≤ ⟨M ⟩t − ⟨M ⟩s ⟨N ⟩t − ⟨N ⟩s . This implies that √ √ E [ sup ∣⟨M, N ⟩s ∣] ≤ (E ⟨M ⟩t ) (E ⟨N ⟩t ) . (3.4) 0≤s≤t'});
CREATE (n:Statement {id: 's/3.3.11', ref: '3.3.11', _kind: 'Lemma', _page: 80, proved_here: true, statement_text: 'Let M be a continuous local martingale with respect to a filtration that satisfies the usual conditions starting in 0. If M is of bounded variation (that is, Vt (M (ω)) < ∞ a.s. for all t ≥ 0), then P[Mt = 0 for all t ≥ 0] = 1.'});
CREATE (n:Statement {id: 'ex/34', ref: '34', _kind: 'Exercise', _page: 81, proved_here: false, statement_text: 'Let M be a continuous local martingale with continuous quadratic variation and τ be a stopping time. If ⟨M ⟩τ = 0, then P[Xτ ∧t = 0, t ∈ [0, ∞)] = 1. Some useful martingale properties'});
CREATE (n:Statement {id: 's/3.3.12', ref: '3.3.12', _kind: 'Lemma', _page: 82, proved_here: true, statement_text: 'Let M be a martingale bounded by K with M0 = 0. For any partition Π = {0 = t0 < t1 < ... < tm = t} of [0, t], 2 E [[Vt2 (M, Π)] ] ≤ 8K 4 .'});
CREATE (n:Statement {id: 's/3.3.13', ref: '3.3.13', _kind: 'Corollary', _page: 82, proved_here: true, statement_text: 'Let M be a bounded continuous martingale starting in zero, and let Vt4 (M, Π) denote the sum of the fourth moments of the increments along the partition Π of [0, t]. Then, lim EVt4 (M, Πn ) = 0. ∣Πn ∣→0'});
CREATE (n:Statement {id: 's/3.3.14', ref: '3.3.14', _kind: 'Remark', _page: 85, proved_here: false, statement_text: 'Notice that the process ⟨M ⟩ can be defined as an L2 -limit for bounded martingales but only as a limit in probability for unbounded, respectively local martingales. 7 This is the reason why we can only expect convergence in probability.'});


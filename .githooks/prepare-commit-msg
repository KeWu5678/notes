#!/usr/bin/env bash
#
# prepare-commit-msg — draft a commit body that summarizes staged changes,
# grouped by top-level folder, using the `claude` CLI.
#
# It PRE-FILLS the message and opens your editor as usual, so you always
# review/edit before the commit is finalized. If `claude` is unavailable,
# times out, or errors, it falls back to a plain per-folder file list so a
# commit is never blocked.
#
# Enabled via:  git config core.hooksPath .githooks
#
set -u

MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Skip for merges, squashes, amends (-c/-C/--amend) and template commits —
# those already carry a meaningful message we shouldn't overwrite.
case "$COMMIT_SOURCE" in
  merge|squash|commit) exit 0 ;;
esac

# Nothing staged (e.g. `git commit` with only unstaged changes) -> do nothing.
if git diff --cached --quiet; then
  exit 0
fi

# --- gather staged changes -------------------------------------------------

# Only .md notes are summarized. Exclude deletions (nothing to summarize).
MD_PATHSPEC="*.md"
MD_FILES="$(git diff --cached --name-only --diff-filter=d -- "$MD_PATHSPEC" 2>/dev/null)"

# No staged .md content -> nothing to summarize, leave the message alone.
if [ -z "$MD_FILES" ]; then
  exit 0
fi

# Per-file name-status, capped in case of huge changesets.
STAT="$(git diff --cached --stat --diff-filter=d -- "$MD_PATHSPEC" 2>/dev/null | head -n 200)"

# Top-level folder -> changed .md files, to steer the model's grouping.
GROUPED="$(
  printf '%s\n' "$MD_FILES" | awk -F/ '
    { grp = (NF > 1 ? $1 : "(root)"); files[grp] = files[grp] "  - " $0 "\n" }
    END { for (g in files) printf "%s:\n%s", g, files[g] }
  ' | head -n 300
)"

# Textual patch of the .md files only, capped to keep the prompt small/fast.
PATCH="$(git diff --cached --no-color --diff-filter=d -- "$MD_PATHSPEC" 2>/dev/null | head -c 60000)"

# --- build the fallback body (used if the model call fails) ----------------

fallback_body() {
  printf '%s\n' "$MD_FILES" | awk -F/ '
    { grp = (NF > 1 ? $1 : "(root)"); files[grp] = files[grp] "  - " $0 ": (describe the change)\n" }
    END { for (g in files) printf "%s:\n%s\n", g, files[g] }
  '
}

# --- ask claude to draft the body ------------------------------------------

PROMPT="You are writing a git commit message BODY for a personal notes vault.
For each TOP-LEVEL folder that changed, summarize the CONTENT of each .md
note that was added or edited — the actual ideas, topics, definitions, and
results — as if writing a table of contents for the material.

Rules:
- Output ONLY the commit body. Start IMMEDIATELY with the first folder header.
  Do NOT restate the task, do not add preamble, markdown fences, or backticks.
- One section per top-level folder, and one bullet per .md file, in this
  EXACT shape (start every bullet with the file's path, then a colon):
    <Folder>:
      - <path/to/file.md>: <substance of that file's content>
- Describe WHAT THE NOTE IS ABOUT, not the git action. Write about the
  concepts (e.g. 'Ito isometry and quadratic variation of Brownian motion'),
  NOT the edit (do NOT write 'added', 'updated', 'modified', 'new file').
- Base each bullet on that file's added/changed lines in the patch below.
- Keep each bullet under ~140 chars. No trailing blank lines.

Changed files by folder:
${GROUPED}

Diffstat:
${STAT}

Patch (may be truncated):
${PATCH}"

# Prefer a timeout wrapper if available so a hung/slow call can't block you.
TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then TIMEOUT_BIN="timeout 45"
elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT_BIN="gtimeout 45"; fi

# Deny every filesystem/web/exec tool so the model summarizes ONLY the patch
# in the prompt — not by roaming the repo (which is slow and off-topic).
NO_TOOLS="Read Bash Glob Grep Edit Write WebFetch WebSearch Task TodoWrite NotebookEdit"

BODY=""
if command -v claude >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  BODY="$(printf '%s' "$PROMPT" | $TIMEOUT_BIN claude -p --disallowedTools $NO_TOOLS 2>/dev/null)"
fi

# Sanitize: strip stray code fences and leading/trailing blank lines.
# (awk for portability — BSD/macOS sed can't do the trim loop.)
# Drop code fences and any chatter before the first "Folder:" header, then
# trim leading/trailing blank lines. (awk for portability — BSD sed can't.)
BODY="$(printf '%s\n' "$BODY" | awk '
  /^```/ { next }
  !started && $0 ~ /^[^[:space:]-].*:[[:space:]]*$/ { started = 1 }
  started { lines[++n] = $0 }
  END {
    s = 1;  while (s <= n && lines[s] ~ /^[[:space:]]*$/) s++
    e = n;  while (e >= s && lines[e] ~ /^[[:space:]]*$/) e--
    for (i = s; i <= e; i++) print lines[i]
  }')"

if [ -z "${BODY//[[:space:]]/}" ]; then
  BODY="$(fallback_body)"
  NOTE="# (auto-summary unavailable — filled a plain file list instead)"
else
  NOTE="# ^ auto-drafted from your staged diff — edit freely before saving."
fi

# --- assemble the final message --------------------------------------------

# Preserve any subject the user already provided (e.g. via -m or a template)
# and git's own comment block (status hints), which live in the current file.
EXISTING_SUBJECT="$(grep -v '^#' "$MSG_FILE" 2>/dev/null | sed '/^[[:space:]]*$/d' | head -n 1)"
COMMENTS="$(grep '^#' "$MSG_FILE" 2>/dev/null)"

{
  printf '%s\n\n' "$EXISTING_SUBJECT"
  printf '%s\n' "$BODY"
  # The note and status comments are `#` lines that git only strips in the
  # editor path (cleanup=strip). With `-m` (cleanup=whitespace) they would
  # leak into the message, so only emit them when an editor will open.
  if [ -z "$COMMIT_SOURCE" ]; then
    printf '\n%s\n' "$NOTE"
    [ -n "$COMMENTS" ] && printf '%s\n' "$COMMENTS"
  fi
} > "$MSG_FILE"

exit 0
